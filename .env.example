# Path to the Packet Tracer executable. Use forward slashes on Windows.
PACKET_TRACER_EXE=C:/Program Files/Cisco Packet Tracer 9.0.0/bin/PacketTracer.exe
# Linux:  PACKET_TRACER_EXE=/opt/pt/packettracer
# macOS:  PACKET_TRACER_EXE=/Applications/Cisco Packet Tracer.app/Contents/MacOS/PacketTracer

PORT=8080
LOG_LEVEL=INFO
